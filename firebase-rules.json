{
  "rules": {
    ".read": false,
    ".write": false,
    "jard": {
      ".read": "auth != null",
      "items": {
        /* أي مستخدم مسجل دخول يقدر يضيف/يمسح الأصناف (المسح بيتم من زر إعادة ضبط المصنع بعد التأكد من كلمة المرور على العميل) */
        ".write": "auth != null",
        "$code": {
          ".validate": "newData.val() == null || newData.hasChildren(['code'])"
        }
      },
      "notifs": {
        ".write": "auth != null",
        "$id": {
          ".validate": "newData.val() == null || (newData.hasChildren(['ts']) && newData.child('ts').isNumber())"
        }
      },
      "auditLog": {
        ".write": "auth != null"
      },
      "sessions": {
        "$user": {
          ".write": "auth != null",
          ".validate": "newData.val() == null || (newData.hasChildren(['ts']) && newData.child('ts').isNumber())"
        }
      },
      "probe-test": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "meta": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
