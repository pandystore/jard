{
  /* ============================================================================
     قواعد حماية قاعدة البيانات — بيمبو جرد

     ⚠️ الملف ده مايشتغلش لوحده: لازم ترفعه على Firebase
        Realtime Database ← Rules ← الصق المحتوى ← Publish

     ملاحظة أمان: كل من سجّل الدخول إلى Firebase (بما في ذلك Anonymous)
     يستطيع قراءة وكتابة البيانات. كلمة مرور البرنامج محلية وليست حماية قاعدة بيانات.
     ============================================================================ */
  "rules": {
    ".read": false,
    ".write": false,

    "jard": {
      ".read": "auth != null",
      ".write": "auth != null",

      /* ---------- الأصناف ----------
         أي مستخدم دخل يقدر يعدّ (يضيف أو يعدّل صنف)،
         الكتابة متاحة لأي جلسة Firebase */
      "items": {
        ".write": "auth != null",
        "$code": {
          ".write": "auth != null",
          ".validate": "newData.val() == null || (newData.hasChildren(['code']) && newData.child('code').isString())"
        }
      },

      /* ---------- الإشعارات ----------
         المستخدم يضيف إشعار بعدّته؛ الأدمن الحقيقي يقدر يمسح العقدة كلها
         (مسح المصنع / تنظيف القديم). القراءة من jard.read = أي مستخدم داخل. */
      "notifs": {
        ".write": "auth != null",
        "$id": {
          ".write": "auth != null",
          ".validate": "newData.val() == null || (newData.hasChildren(['ts']) && newData.child('ts').isNumber())"
        }
      },

      /* ---------- سجل العمليات ----------
         إضافة بس: مفيش تعديل ولا مسح لسجل موجود (عشان محدش يموّي أثره) */
      "auditLog": {
        "$id": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['ts'])"
        }
      },

      /* ---------- الجلسات ----------
         ملاحظة بصراحة: المستخدمين العاديين بيدخلوا بهوية مجهولة (anonymous)
         على Firebase، فالسيرفر مايعرفش مين صاحب الجلسة الحقيقي.
         اللي هنا يمنع الكتابة الغلط ويثبت شكل البيانات بس.
         الحماية الكاملة محتاجة حساب Firebase حقيقي لكل مستخدم. */
      "sessions": {
        ".write": "auth != null",
        "$user": {
          ".write": "auth != null",
          ".validate": "newData.val() == null || (newData.hasChildren(['ts']) && newData.child('ts').isNumber() && newData.child('name').isString())"
        }
      },

      "kicks": {
        "$user": {
          ".write": "auth != null",
          ".validate": "newData.val() == null || newData.isNumber()"
        }
      },

      "probe-test": {
        ".read": "auth != null",
        ".write": "auth != null"
      },

      /* ---------- الإعدادات والمستخدمين ----------
         دي أخطر عقدة في القاعدة: فيها كلمات المرور وقايمة المستخدمين.
         قبل كده كانت مفتوحة لأي حد → أي حد كان يقدر يعمل نفسه أدمن. */
      "meta": {
        ".read": "auth != null",

        /* كلمة المرور وقائمة المستخدمين تُدار من داخل التطبيق؛ الوصول محمي بتسجيل Firebase. */
        "adminHash": { ".write": "auth != null" },
        "users": { ".write": "auth != null" },
        "usersRev": { ".write": "auth != null" },
        "forceWipe": { ".write": "auth != null" },
        "lastWipe": { ".write": "auth != null" },
        "lastWipeRev": { ".write": "auth != null" },
        "lastWipeBy": { ".write": "auth != null" },

        /* مفاتيح عادية — أي مستخدم داخل يقدر يكتبها */
        "setupDone": { ".write": "auth != null" },
        "logo":      { ".write": "auth != null" },
        "dt":        { ".write": "auth != null" },
        "uploadedAt": { ".write": "auth != null" },
        "lastEditAt": { ".write": "auth != null" },
        "lastEditBy": { ".write": "auth != null" }
      }
    }
  }
}
