{
  "rules": {
    ".read": false,
    ".write": false,
    "jard": {
      ".read": "auth != null",
      "items": {
        ".write": "auth != null && (!data.exists() || root.child('jard/meta/adminUid').val() == auth.uid)",
        "$code": {
          ".write": "auth != null && (newData.exists() || root.child('jard/meta/adminUid').val() == auth.uid)",
          ".validate": "newData.val() == null || newData.hasChildren(['code'])"
        }
      },
      "notifs": {
        ".write": "auth != null",
        "$id": {
          ".validate": "newData.hasChildren(['ts']) && newData.child('ts').isNumber()"
        }
      },
      "auditLog": {
        ".write": "auth != null"
      },
      "sessions": {
        "$user": {
          ".write": "auth != null",
          ".validate": "newData.val() == null || (newData.hasChildren(['ts']) && newData.child('ts').isNumber())"
        }
      },
      "probe-test": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "meta": {
        /* أي مستخدم مسجل دخول يقدر يقرا meta (لازم عشان يشوف قائمة المستخدمين) */
        ".read": "auth != null",
        "adminUid": {
          ".write": "auth != null && !data.exists()"
        },
        "config": {
          ".write": "auth != null"
        },
        "configRev": {
          ".write": "auth != null"
        },
        "adminHash": {
          ".write": "auth != null"
        },
        "users": {
          /* أي مستخدم مسجل دخول يقدر يضيف/يعدل المستخدمين (الإضافة بتتم من شاشة الإعدادات لما تكون متسجل كأدمن،
             والـ client-side بيمنع غير الأدمن، لكن القاعدة بقت مفتوحة عشان أي جهاز لما يعمل seedDefaultAdmin
             أو pushMeta يقدر يكتب قائمة المستخدمين من غير مايتقفل بسبب الـ adminUid القديم) */
          ".write": "auth != null"
        },
        "loginRequiredExplicit": {
          ".write": "auth != null"
        },
        "usersRev": { ".write": "auth != null" },
        "dt": { ".write": "auth != null" },
        "logo": { ".write": "auth != null" }
      }
    }
  }
}
